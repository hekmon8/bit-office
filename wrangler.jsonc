{
  "name": "bit-office",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "agents.hekmon.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "OFFICE", "class_name": "OfficeStore" }]
  },
  "migrations": [{ "tag": "v1-office-store", "new_sqlite_classes": ["OfficeStore"] }],
  "env": {
    "staging": {
      "name": "bit-office-staging",
      "workers_dev": true,
      "routes": [],
      "durable_objects": {
        "bindings": [{ "name": "OFFICE", "class_name": "OfficeStore" }]
      }
    }
  }
}
