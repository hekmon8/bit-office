# Copy to .dev.vars, chmod 600, and fill in locally. Never commit credentials.
# This endpoint verifies connectivity against synthetic demo data; replace it for real data.
UPSTREAM_MCP_URL="https://agents.hekmon.com/mcp"
UPSTREAM_MCP_AUTH="none"
# Required for bearer/api_key; keep unset for none.
# UPSTREAM_MCP_TOKEN=""
# Adapter read credential: at least 32 characters, independent of the upstream token.
LIVE_READ_TOKEN=""
# Optional; used only with api_key:
# UPSTREAM_MCP_API_KEY_HEADER="X-API-Key"
# Optional; must be an explicitly read-only, empty-argument office snapshot tool:
# UPSTREAM_MCP_STATE_TOOL="get_office_state"

# Optional managed-office MCP tools at the same /mcp endpoint.
# Generate a separate, high-entropy token locally (at least 32 characters).
# It must differ from both LIVE_READ_TOKEN and UPSTREAM_MCP_TOKEN.
# OFFICE_MCP_TOKEN=""
